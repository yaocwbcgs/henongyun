# ---- 基础 ----
NODE_ENV=development
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173,http://localhost:3001
DATA_DIR=./data
UPLOAD_DIR=./uploads
DB_PATH=./data/henongyun.db
LOG_LEVEL=info

# 生产必须设置为 32 位以上随机字符串：openssl rand -hex 32
JWT_SECRET=

# ---- 邮件（找回密码 / 验证码）----
# 免费方案：QQ 邮箱 → 设置 → 账号与安全 → 开启 SMTP → 生成 16 位授权码
#   SMTP_HOST=smtp.qq.com / SMTP_PORT=465 / SMTP_SECURE=true
#   SMTP_USER=你的QQ邮箱 / SMTP_PASS=授权码（不是QQ密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=禾农云 <no-reply@example.com>

# ---- 病虫害识别（Plant.id v3）----
# 免费方案：https://admin.kindwise.com/signup 注册即送 100 credits（1 次识别 = 1 credit）
RECOGNITION_PROVIDER=plantid
PLANTID_API_KEY=
PLANTID_BASE_URL=https://api.plant.id/v3

# ---- 在线支付（Stripe Checkout）----
# 说明：Stripe 不支持中国大陆主体直接开户；无密钥时可使用「线下结算」完成完整订单流程
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=cny

# ---- 行情数据接口（可选）----
MARKET_API_URL=
MARKET_API_KEY=

# ---- 限流 ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=12

# 是否写入演示数据（生产请设为 false）
DEMO_SEED=true
